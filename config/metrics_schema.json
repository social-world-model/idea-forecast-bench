{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluatorMetrics",
  "type": "object",
  "required": ["config", "aggregate", "domains"],
  "properties": {
    "config": {
      "type": "object",
      "required": ["k_values", "semantic_threshold", "keyword_threshold"],
      "properties": {
        "k_values": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "semantic_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "keyword_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "aggregate": {
      "type": "object",
      "required": ["mrr"],
      "additionalProperties": { "type": "number" }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "n_predictions", "n_truth", "mrr", "metrics"],
        "properties": {
          "domain": { "type": "string" },
          "n_predictions": { "type": "integer", "minimum": 0 },
          "n_truth": { "type": "integer", "minimum": 0 },
          "mrr": { "type": "number", "minimum": 0, "maximum": 1 },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        }
      }
    }
  }
}
